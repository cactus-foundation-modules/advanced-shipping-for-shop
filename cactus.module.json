{
  "name": "advanced-shipping-for-shop",
  "version": "0.1.14",
  "tablePrefix": "ash_",
  "description": "Advanced delivery dates and per-item service tiers for the Shop: concrete working-day delivery estimates keyed on supplier, category and product range, with a cart-time delivery-and-assembly tier picker priced into the order.",
  "requiresCoreVersion": "0.5.698",
  "requiresModules": [
    { "name": "shop", "minVersion": "0.1.119" },
    { "name": "product-attributes-for-shop", "minVersion": "0.1.27" }
  ],
  "requiredEnvVars": [],
  "permissions": [],
  "navEntries": [],
  "cookieCategories": [],
  "settingsTabs": [],
  "extensionPoints": [
    {
      "point": "shop.cart-line-resolver",
      "id": "shipping-tier",
      "import": "./lib/line-resolver",
      "component": "resolveShippingTierLineMeta"
    },
    {
      "point": "shop.cart-line-resolver-prefetch",
      "id": "shipping-tier",
      "import": "./lib/line-resolver",
      "component": "prefetchShippingTierDeliveries"
    },
    {
      "point": "shop.product-editor-sections",
      "id": "advanced-shipping-delivery",
      "label": "Delivery",
      "order": 60,
      "permission": "shop.products",
      "import": "./components/admin/ProductDeliverySection",
      "component": "ProductDeliverySection"
    },
    {
      "point": "shop.tax-shipping-tabs",
      "id": "delivery-rules",
      "label": "Delivery rules",
      "order": 10,
      "permission": "shop.manage",
      "import": "./components/admin/RulesScreen",
      "component": "RulesScreen"
    },
    {
      "point": "shop.tax-shipping-tabs",
      "id": "service-tiers",
      "label": "Service tiers",
      "order": 20,
      "permission": "shop.manage",
      "import": "./components/admin/TiersScreen",
      "component": "TiersScreen"
    },
    {
      "point": "shop.tax-shipping-tabs",
      "id": "holidays",
      "label": "Holidays",
      "order": 30,
      "permission": "shop.manage",
      "import": "./components/admin/HolidaysScreen",
      "component": "HolidaysScreen"
    },
    {
      "point": "shop.tax-shipping-tabs",
      "id": "delivery-settings",
      "label": "Delivery settings",
      "order": 40,
      "permission": "shop.manage",
      "import": "./components/admin/SettingsScreen",
      "component": "SettingsScreen"
    }
  ],
  "puckBlocks": [
    {
      "type": "ShopDeliveryEstimate",
      "import": "./components/puck/ShopDeliveryEstimate",
      "component": "shopDeliveryEstimatePuckComponent",
      "rscComponent": "shopDeliveryEstimatePuckRscComponent",
      "rscImport": "./components/puck/ShopDeliveryEstimate.rsc",
      "layoutTypes": ["shopProductDetail", "shopProduct"]
    },
    {
      "type": "ShopDeliveryCartSummary",
      "import": "./components/puck/ShopDeliveryCartSummary",
      "component": "shopDeliveryCartSummaryPuckComponent",
      "rscComponent": "shopDeliveryCartSummaryPuckRscComponent",
      "rscImport": "./components/puck/ShopDeliveryCartSummary.rsc",
      "layoutTypes": ["shopCart"]
    }
  ],
  "cronJobs": [
    { "path": "/api/m/advanced-shipping-for-shop/cron/refresh-holidays", "schedule": "0 3 * * 1" }
  ],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "routeTiers": []
  },
  "teardown": [
    "ash_product_overrides",
    "ash_tier_scope_config",
    "ash_service_tiers",
    "ash_delivery_rules",
    "ash_holidays",
    "ash_settings"
  ]
}
